{
  "name": "dsh-voice",
  "version": "0.10.2",
  "description": "DeepSeek Harness 语音工作台插件（支持 5 套工作台主题：原生清透 / 米白纸感 / Claude 暖书卷 / 8-Bit 像素 / 晴空薄荷）：零密钥 Edge TTS 朗读、声音克隆、字幕卡点配音、播客 BGM 自动闪避、多角色与字幕导出、在线试听及多引擎 ASR 转写。欢迎提交 issues 和 PR。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/plugin-icon.webp"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md",
    "src/edge-drm-v2.ts",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md",
    "assets/plugin-icon.webp",
    "locale",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-updates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:integration": "npm run build && node --test \"integration/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "tts",
    "stt",
    "whisper",
    "voice",
    "dsh-plugin",
    "deepseek",
    "ai-agent",
    "edge-tts",
    "语音合成",
    "语音识别"
  ],
  "license": "MIT AND LGPL-3.0-only",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "undici": "^8.10.0",
    "ws": "^8.21.3",
    "@stardustlc/dsh-updates": "0.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-voice.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-voice/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-voice#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0",
  "icon": "./assets/plugin-icon.webp"
}
